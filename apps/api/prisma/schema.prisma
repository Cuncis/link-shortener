generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
}

model Link {
    id        Int      @id @default(autoincrement())
    slug      String   @unique @db.VarChar(32)
    url       String   @db.VarChar(2048)
    clicks    Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([createdAt])
    @@map("links")
}
