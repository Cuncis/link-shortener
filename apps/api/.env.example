NODE_ENV=development
PORT=3001
# Address to listen on (use 0.0.0.0 inside Docker/production)
HOST=127.0.0.1

# Must match the credentials in the root .env / docker-compose.yml
DATABASE_URL="mysql://root:root@localhost:3306/linkshortener"

# Public URL of this API, used to build short links like {BASE_URL}/abc123
BASE_URL=http://localhost:3001

# Origin of the Next.js frontend (for CORS)
CORS_ORIGIN=http://localhost:3000
